-- Constants
local COLOR_GOLD = Color3.fromRGB(255, 215, 0)
local COLOR_YELLOW = Color3.fromRGB(255, 128, 128)
local COLOR_GRAY = Color3.fromRGB(255, 0, 0)
local TARGET_COLOR = Color3.fromRGB(52, 78, 58)

-- Required subjects table
local REQUIRED_SUBJECTS = {
    ["Cursed Object"] = true,
    ["Boo-Boo Doll"] = true,
    ["Burning Crucifix"] = true,
    ["Ghost"] = true
}

local cachedInstances = {
    photoSubjects = {},
    selections = {},
    thhComplete = THHComplete
}

-- Cache PhotoSubjects
local function cachePhotoSubjects()
    cachedInstances.photoSubjects = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    for _, instance in ipairs(playerGui:GetDescendants()) do
        if instance.Name == "PhotoSubject" and instance:IsA("TextLabel") then
            table.insert(cachedInstances.photoSubjects, instance)
        end
    end
end

-- Cache Selection buttons (Hierarchy: ImageButton -> Frame -> CanvasGroup -> Frame)
local function cacheSelections()
    cachedInstances.selections = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    for _, instance in ipairs(playerGui:GetDescendants()) do
        if instance:IsA("ImageButton") then
            local p1 = instance.Parent
            if p1 and p1:IsA("Frame") then
                local p2 = p1.Parent
                if p2 and p2:IsA("CanvasGroup") then
                    local p3 = p2.Parent
                    if p3 and p3:IsA("Frame") then
                        table.insert(cachedInstances.selections, instance)
                    end
                end
            end
        end
    end
end

-- Check PhotoSubjects completion
local function checkPhotoSubjects()
    local foundSubjects = {}
    local foundCount = 0
    for _, photoSubject in ipairs(cachedInstances.photoSubjects) do
        local text = photoSubject.Text or ""
        if REQUIRED_SUBJECTS[text] and not foundSubjects[text] then
            foundSubjects[text] = true
            foundCount = foundCount + 1
        end
    end
    -- Return true if all required subjects were found
    local totalRequired = 0
    for _ in pairs(REQUIRED_SUBJECTS) do totalRequired = totalRequired + 1 end
    return foundCount >= totalRequired
end

-- Check Selections completion (Color match)
local function checkSelections()
    for _, selection in ipairs(cachedInstances.selections) do
        local c = selection.BackgroundColor3
        
        -- Using a very generous tolerance to ensure detection of (0.204, 0.306, 0.227)
        if math.abs(c.R - 0.204) < 0.05 and 
           math.abs(c.G - 0.306) < 0.05 and 
           math.abs(c.B - 0.227) < 0.05 then
            return true
        end
    end
    return false
end

-- Animation
local blinkThread = nil
local shouldBlink = false

local function startBlinkingAnimation()
    shouldBlink = false
    if blinkThread then
        pcall(function() task.cancel(blinkThread) end)
        blinkThread = nil
    end
    shouldBlink = true
    blinkThread = task.spawn(function()
        while shouldBlink and cachedInstances.thhComplete do
            cachedInstances.thhComplete.ImageTransparency = 0
            task.wait(0.1)
            for i = 1, 20 do
                if not shouldBlink or not cachedInstances.thhComplete then return end
                cachedInstances.thhComplete.ImageTransparency = i/20
                task.wait(0.05)
            end
            task.wait(1)
        end
    end)
end

local function stopBlinkingAnimation()
    shouldBlink = false
    if blinkThread then
        pcall(function() task.cancel(blinkThread) end)
        blinkThread = nil
    end
    if cachedInstances.thhComplete then
        cachedInstances.thhComplete.ImageTransparency = 0
    end
end

-- Update Color
local function updateTHHColor(step1Complete, step2Complete)
    if not cachedInstances.thhComplete then return end
    local newColor = COLOR_GRAY
    if step1Complete and step2Complete then
        newColor = COLOR_GOLD
    elseif step1Complete or step2Complete then
        newColor = COLOR_YELLOW
    end
    cachedInstances.thhComplete.ImageColor3 = newColor
    if newColor == COLOR_YELLOW or newColor == COLOR_GRAY then
        startBlinkingAnimation()
    else
        stopBlinkingAnimation()
    end
end

local function checkChallenges()
    local step1Complete = checkPhotoSubjects()
    local step2Complete = checkSelections()
    updateTHHColor(step1Complete, step2Complete)
end

local function setupMonitoring()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        playerGui.DescendantAdded:Connect(function(instance)
            if instance.Name == "PhotoSubject" and instance:IsA("TextLabel") then
                table.insert(cachedInstances.photoSubjects, instance)
            elseif instance:IsA("ImageButton") then
                local p1 = instance.Parent
                if p1 and p1:IsA("Frame") then
                    local p2 = p1.Parent
                    if p2 and p2:IsA("CanvasGroup") then
                        local p3 = p2.Parent
                        if p3 and p3:IsA("Frame") then
                            table.insert(cachedInstances.selections, instance)
                        end
                    end
                end
            end
        end)
        playerGui.DescendantRemoving:Connect(function(instance)
            for i, v in ipairs(cachedInstances.photoSubjects) do
                if v == instance then table.remove(cachedInstances.photoSubjects, i) break end
            end
            for i, v in ipairs(cachedInstances.selections) do
                if v == instance then table.remove(cachedInstances.selections, i) break end
            end
        end)
    end
    cachePhotoSubjects()
    cacheSelections()
    task.spawn(function()
        while true do
            checkChallenges()
            task.wait(0.5)
        end
    end)
end

task.spawn(function()
    task.wait(1)
    setupMonitoring()
end)


