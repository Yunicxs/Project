local function bothEvidenceChallengesActive()
	local challenges = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Van")
		and Workspace.Map.Van:FindFirstChild("CoreElements") and Workspace.Map.Van.CoreElements:FindFirstChild("TimerModel")
