local function markEvidence(name)
	if detected[name] then
		local frame = findEvidenceFrame()
		if not frame then return end
		local item = frame:FindFirstChild(name)
		if item then
			local txt = item:FindFirstChild("More") and item.More:FindFirstChild("TextLabel")
			if txt then
				txt.TextColor3 = GREEN
			end
		end
		return
	end
	local frame = findEvidenceFrame()
	if not frame then return end
	local item = frame:FindFirstChild(name)
	if item then
		local txt = item:FindFirstChild("More") and item.More:FindFirstChild("TextLabel")
		if txt then
			txt.TextColor3 = GREEN
		end
	end
	detected[name] = true
end

