			lastItemsSnapshot = children
		end
		local sp = Workspace:FindFirstChild("SoundPart")
		if sp then
			-- fire again on every new SoundPart appearance (a destroyed + re-spawned
			-- part is a new instance, so comparing instances catches repeated sounds)
			if sp ~= lastSoundPart then
				local root = sp:IsA("BasePart") and sp or sp:FindFirstChild("PrimaryPart") or sp:FindFirstChildWhichIsA("BasePart")
				local zone = resolveZone(root.Position)
