local getRoot = function(char)
	local hum = char:FindFirstChildWhichIsA("Humanoid")
	if hum then
		return hum, hum.RootPart
	end
	if char.PrimaryPart then
		return nil, char.PrimaryPart
	end
	return nil, nil
end

local function explodeRespawn()
	local char = LocalPlayer.Character
	if not char then
		return false, "no character"
	end
	local hum, root = getRoot(char)
	if not hum or not root then
		return false, "no humanoid/root"
	end

	healFallenHeight()
	local archive = workspace.FallenPartsDestroyHeight
	local camType = workspace.CurrentCamera.CameraType
	local restore = function()
		workspace.FallenPartsDestroyHeight = archive
		_G.reviveFallenGood = archive
		if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
			workspace.CurrentCamera.CameraType = camType
		end
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	workspace.FallenPartsDestroyHeight = 0 / 0
	local push = function()
		root.Anchored = false
		root.AssemblyLinearVelocity = Vector3.new(0, -250, 0)
		root.CFrame = CFrame.new(0, archive - 3000, 0)
	end
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
	push()
	local deadline = os.clock() + 3
	while os.clock() < deadline do
		if not root.Parent then
			break
		end
		push()
		task.wait(0.05)
	end
	local success, err = pcall(function()
		restore()
		root.CFrame = CFrame.new(0, archive - 100, 0)
		local t = os.clock()
		while os.clock() - t < 5 do
			if not root.Parent then
				return
			end
			if hum.Health <= 0 or not hum.Parent then
				return
			end
			task.wait(0.1)
		end
	end)
	if not success then
		restore()
		return false, err
	end
	if not root.Parent or hum.Health <= 0 or not hum.Parent then
		return true
	end
	return false, "character survived"
end

local function respawn()
	task.spawn(function()
		for attempt = 1, 3 do
			local ok, info = pcall(explodeRespawn)
			if ok and info ~= "no character" and info ~= "no humanoid/root" then
				print("Respawned (attempt " .. attempt .. ")")
				return
			end
			warn("Respawn attempt " .. attempt .. " failed: " .. tostring(info))
			task.wait(0.8)
		end
		warn("Respawn gave up after 3 attempts")
	end)
end

local showing = false
local timedOut = false
local inFade = false
local timerTask = nil

local DOUBLE_TAP_WINDOW = 0.75
local lastYTime = 0
local pendingReopen = nil

local function cancelTimer()
	if timerTask then
		task.cancel(timerTask)
	end
	timerTask = nil
end

local function setTransparency(target)
	inFade = true
	local twn = TweenService:Create(
		CanvasGroup,
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ GroupTransparency = target }
	)
	twn:Play()
	twn.Completed:Once(function()
		inFade = false
	end)
end

local function closePrompt()
	if not stillMine() then
		return
	end
	showing = false
	cancelTimer()
	_G.freemouse = false
	setTransparency(1)
	task.spawn(function()
		task.wait(FADE_DURATION)
		if stillMine() then
			Revive.Enabled = false
		end
	end)
end

local function playHeaderAnim()
	if UIScale then
		UIScale.Scale = 5
		TweenService:Create(
			UIScale,
			TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1.2 }
		):Play()
	end
end

local function openPrompt()
	if not stillMine() then
		return
	end
	showing = true
	timedOut = false
	Revive.Enabled = true
	CanvasGroup.GroupTransparency = 1
	playHeaderAnim()
	setTransparency(0)
	_G.freemouse = true
	cancelTimer()
	local remaining = TIMEOUT
	TimerLabel.Text = tostring(remaining)
	timerTask = task.spawn(function()
		while remaining > 0 do
			task.wait(1)
			if not stillMine() then
				return
			end
			remaining = remaining - 1
			if not showing then
				return
			end
			TimerLabel.Text = tostring(remaining)
			if remaining == 5 then
				TimerLabel.TextColor3 = Color3.fromRGB(152, 40, 37)
			end
		end
		if showing then

			timerTask = nil
			closePrompt()
			timedOut = true
		end
	end)
end

local function callRespawn()
	closePrompt()
	respawn()
end

local function scheduleReopen()
	pendingReopen = task.spawn(function()
		task.wait(DOUBLE_TAP_WINDOW)
		pendingReopen = nil
		if stillMine() and not showing and timedOut and LocalPlayer.Dead.Value then
			openPrompt()
		end
	end)
end

-- Server still tells us when to open/close; we just handle it ourselves.
PromptRevivePurchase.OnClientEvent:Connect(function(state)
	if not stillMine() then
		return
	end
	if state == "Open" then
		openPrompt()
	elseif state == "Close" then
		closePrompt()
	end
end)

-- Fallback: if Dead goes true directly, open the screen too.
Dead.Changed:Connect(function(changed)
	if not stillMine() then
		return
	end
	if changed then
		if not showing then
			openPrompt()
		end
	else
		closePrompt()
	end
end)

healFallenHeight()
if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
end

if Dead.Value then
	openPrompt()
end

YesButton.MouseButton1Click:Connect(function()
	if not stillMine() then
		return
	end
	if showing then
		callRespawn()
	end
end)

NoButton.MouseButton1Click:Connect(function()
	if not stillMine() then
		return
	end
	if showing then
		closePrompt()
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not stillMine() then
		return
	end
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Y then
		if showing then
			callRespawn()
		elseif timedOut and LocalPlayer.Dead.Value then
			local now = os.clock()
			if pendingReopen and now - lastYTime <= DOUBLE_TAP_WINDOW then
				-- Second Y inside the window: skip the UI entirely, respawn now.
				task.cancel(pendingReopen)
				pendingReopen = nil
				timedOut = false
				respawn()
			else
				lastYTime = now
				scheduleReopen()
			end
		end
	elseif input.KeyCode == Enum.KeyCode.N then
		if showing then
			closePrompt()
		end
	end
end)

