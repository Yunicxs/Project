local function healFallenHeight()
	if workspace.FallenPartsDestroyHeight ~= workspace.FallenPartsDestroyHeight then
		workspace.FallenPartsDestroyHeight = _G.reviveFallenGood or FALLEN_DEFAULT
	else
		_G.reviveFallenGood = workspace.FallenPartsDestroyHeight
	end
end

