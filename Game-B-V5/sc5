local function findEvidenceFrame()
	local plr = Players.LocalPlayer
	if not plr then return nil end
	local j = plr:FindFirstChild("PlayerGui") and plr.PlayerGui:FindFirstChild("Journal")
	if not j then return nil end
	local ev = j:FindFirstChild("Background") and j.Background:FindFirstChild("MainContent")
