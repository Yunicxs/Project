local function checkFreezing()
	local map = Workspace:FindFirstChild("Map")
	if not map then return false end
	local zones = map:FindFirstChild("Zones")
	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("NumberValue") and descendant.Name == "_____Temperature" and descendant.Value < 0.05 then
			-- the Outside safe-zone does not count toward Freezing Temp. evidence
			if zones and descendant:IsDescendantOf(zones) then
				local ancestor = descendant.Parent
				while ancestor and ancestor ~= zones do
					if ancestor.Name == "Outside" then
						break
					end
					ancestor = ancestor.Parent
				end
				if ancestor == zones then
					-- never passed through a zone named Outside
					return true
				end
			else
				return true
			end
		end
	end
	return false
end

