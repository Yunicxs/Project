local function resolveZone(pos)
	local zones = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Zones")
	if not zones then return "Unknown" end
	local best, bestVol = nil, math.huge
	for _, z in ipairs(zones:GetChildren()) do
		if z:IsA("BasePart") then
			local isz = z:FindFirstChild("IsZone")
			if isz and isz.Value then
				local localPos = z.CFrame:PointToObjectSpace(pos)
				local half = z.Size / 2
				if math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z then
					local vol = z.Size.X * z.Size.Y * z.Size.Z
					if vol < bestVol then
						best, bestVol = z.Name, vol
					end
				end
			end
		end
	end
	return best or "Unknown"
end

