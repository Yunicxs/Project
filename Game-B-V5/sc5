-- Achievement-style popup cloned from the game's own AchievementsClient
-- template. Title = the stolen tool's name, Description = tools left on map.
-- Mirrors CreateNotification() in Players.Shypuu.PlayerGui.AchievementUI:
-- slide in, hold ~7.5s, slide out, destroy.
local function showStolenNotification(toolName, toolsLeft)
	local plr = Players.LocalPlayer
	if not plr then return end
	local pg = plr:FindFirstChild("PlayerGui")
	if not pg then return end
	local ach = pg:FindFirstChild("AchievementUI")
	if not ach then return end
	local client = ach:FindFirstChild("AchievementsClient")
	local container = ach:FindFirstChild("NotificationContainer")
	if not client or not container then return end
	local template = client:FindFirstChild("NotificationLane")
	if not template then return end

	local function play()
		local lane = template:Clone()
		local plate = lane.NotificationPlate
		plate.Labels.Title.Text = ("Items Stolen: %s"):format(toolName)
		plate.Labels.Description.Text = ("Items left: %d"):format(toolsLeft)
		local thumb = plate.Thumbnail
		if thumb then
			thumb.Image = "rbxassetid://80346439255353"
		end
		local prog = plate.Labels:FindFirstChild("Progress")
		if prog then
			prog.Visible = false
			plate.Labels.Description.Visible = true
		end
		-- "Brutal" difficulty glow, exactly like AchievementsClient does for
		-- Brutal achievements: red BooBooGlow, fade to 20%, hold, fade back out
		local glowHalo = lane:FindFirstChild("GlowContainer")
		if glowHalo then
			local glow = glowHalo:FindFirstChild("Glow")
			if glow then
				glowHalo.Visible = true
				glow.ImageColor3 = Color3.fromRGB(255, 85, 111)
				glow.ImageTransparency = 1
				task.spawn(function()
					local fadeIn = TweenService:Create(glow, TweenInfo.new(1.25), { ImageTransparency = 0.2 })
					fadeIn:Play()
					fadeIn.Completed:Wait()
					task.wait(1)
					TweenService:Create(glow, TweenInfo.new(0.5), { ImageTransparency = 1 }):Play()
				end)
			end
		end
		lane.Parent = container
		local slideIn = TweenService:Create(plate, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), {
			Position = UDim2.new(1, -20, 0, 0),
		})
		slideIn:Play()
		task.wait(3)
		local slideOut = TweenService:Create(plate, TweenInfo.new(0.25), {
			Position = UDim2.new(1, plate.AbsoluteSize.X + 10, 0, 0),
		})
		slideOut:Play()
		slideOut.Completed:Wait()
		lane:Destroy()
	end

	task.spawn(play)
end

local function isConsumableTool(tool)
	if tool.Name == "Salt" then
		return true
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("NumberValue") and d.Name == "Capacity" then
			return true
		end
	end
	return false
end

-- orphan handles at the workspace root (direct children), the salt-consumed leftover
getRootHandles = function()
	local handles = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "Handle" then
			handles[child] = true
		end
	end
	return handles
end

takeRootHandleSnapshot()

-- is this tool instance held by any player, in any of the three holding spots?
local function isHeldCampaign(tool)
	for _, plr in ipairs(Players:GetPlayers()) do
		-- Slot1..Slot5 ObjectValue references
		for i = 1, 5 do
			local slot = plr:FindFirstChild("Slot" .. i)
			if slot and slot.Value == tool then
				return true
			end
		end
		-- backpack children (indexing a held tool)
		for _, child in ipairs(plr.Backpack:GetChildren()) do
			if child == tool then
				return true
			end
		end
		-- equipped in the workspace player model
		local model = Workspace:FindFirstChild(plr.Name)
		if model then
			for _, child in ipairs(model:GetChildren()) do
				if child == tool then
					return true
				end
			end
		end
	end
	return false
end

task.spawn(function()
	paintWhite()
	while stateRoot.gen == MY_GEN do
		local items = getItemsFolder()
		if items then
			-- tools currently present on the map (same instances we track)
			local present = {}
			for _, child in ipairs(items:GetChildren()) do
				if child:IsA("Tool") then
					present[child] = true
					if not seen[child] then
						seen[child] = { name = child.Name, className = child.ClassName, state = "seen", consumable = isConsumableTool(child) }
						-- record when this instance first showed up on the map;
						-- baseline instances (script start) get 0 so they are never
						-- mistaken for a throw replacement
						appearAt[child] = baselineDone and tick() or 0
					end
				end
			end
			baselineDone = true

			-- round-reset safety: if nearly the whole tracked set disappeared in one
			-- sweep and was replaced by fresh instances, it was a new round, not Nook.
			local liveCount = 0
			for inst in pairs(seen) do
				if present[inst] then
					liveCount = liveCount + 1
				end
			end
			local totalSeen = 0
			for _ in pairs(seen) do totalSeen = totalSeen + 1 end
			if totalSeen > 0 and liveCount == 0 and #items:GetChildren() > 0 then
				-- map completely rebuilt -> new round: reset tracking AND the latch
				for inst in pairs(seen) do seen[inst] = nil end
				for inst in pairs(pendingMissing) do pendingMissing[inst] = nil end
				for inst in pairs(appearAt) do appearAt[inst] = nil end
				for child, _ in pairs(present) do
					seen[child] = { name = child.Name, className = child.ClassName, state = "seen", consumable = isConsumableTool(child) }
					appearAt[child] = 0
				end
				stolen = false
				paintWhite()
				takeRootHandleSnapshot()
			else
				-- scan tracked instances: gone AND not held anywhere => stolen
				local mapToolsLeft = 0
				for _, child in ipairs(items:GetChildren()) do
					if child:IsA("Tool") then
						mapToolsLeft = mapToolsLeft + 1
					end
				end
				-- any NEW orphan handle counts as a "consumable used up" witness
				-- any NEW orphan handle marks consumables as "used up" for the whole round
				local freshHandles = getRootHandles()
				for h in pairs(freshHandles) do
					if not knownRootHandles[h] then
						roundHasFreshHandle = true
						break
					end
				end
				knownRootHandles = freshHandles

				-- GlowStick throw: the server destroys the held tool and spawns a
				-- fresh same-named instance on the map. A held GlowStick that goes
				-- missing is a throw (replacement appears) or a pending real steal
				-- (nothing appears) - never an immediate steal. Only GlowStick has
				-- this throw mechanic.
				local function findThrowReplacement(inst, meta, since)
					for child, _ in pairs(present) do
						if child ~= inst and child.Name == meta.name then
							local at = appearAt[child]
							if at and at >= since then
								return child
							end
						end
					end
					return nil
				end

				for inst, meta in pairs(seen) do
					if not present[inst] and meta.state ~= "stolen" and meta.state ~= "consumed" then
						if isHeldCampaign(inst) then
							meta.state = "held"
						elseif meta.consumable and roundHasFreshHandle then
							-- salt ran out: destroyed, Handle left behind -> used up, not stolen
							meta.state = "consumed"
							print(("[NookTraits] CONSUMED: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
						elseif meta.name == "GlowStick" then
							-- a freshly-spawned same-named instance is the throw's
							-- replacement: the old one was destroyed by the game
							if findThrowReplacement(inst, meta, tick() - THROW_GRACE) then
								seen[inst] = nil
								print(("[NookTraits] THROWN: %s returned to the map"):format(meta.name))
							elseif not pendingMissing[inst] then
								-- wait a moment for the replacement to spawn
								pendingMissing[inst] = tick()
								meta.state = "pending"
							end
						elseif meta.name == "Sanity Soda" then
							-- drinking destroys the tool with no leftover Handle and no
							-- replacement (verified: orphan Handles stay 0). A soda that
							-- was held right up until it vanished was drunk, not stolen;
							-- a map soda vanishing unpicked is a real theft.
							if meta.state == "held" then
								meta.state = "consumed"
								print(("[NookTraits] CONSUMED: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
							else
								meta.state = "stolen"
								stolen = true
								showStolenNotification(meta.name, mapToolsLeft)
								print(("[NookTraits] STOLEN: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
							end
						else
							meta.state = "stolen"
							stolen = true
							showStolenNotification(meta.name, mapToolsLeft)
							print(("[NookTraits] STOLEN: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
						end
					end
				end

				-- resolve pending GlowStick throws: if a replacement appeared since
				-- the instance went missing, it was thrown, not stolen
				local now = tick()
				for inst, since in pairs(pendingMissing) do
					local meta = seen[inst]
					if not meta then
						pendingMissing[inst] = nil
					elseif present[inst] then
						-- came back on its own: safe again
						meta.state = "seen"
						pendingMissing[inst] = nil
					else
						local replacement = findThrowReplacement(inst, meta, since)
						if replacement then
							seen[inst] = nil
							pendingMissing[inst] = nil
							print(("[NookTraits] THROWN: %s returned to the map"):format(meta.name))
						elseif now - since > THROW_GRACE then
							-- no replacement in time: real steal
							meta.state = "stolen"
							stolen = true
							pendingMissing[inst] = nil
							showStolenNotification(meta.name, mapToolsLeft)
							print(("[NookTraits] STOLEN: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
						end
					end
				end

				-- a previously-held tool dropped back between scans is safe again
				for inst, meta in pairs(seen) do
					if present[inst] and meta.state == "held" then
						meta.state = "seen"
					end
				end
			end

			if stolen then
				paintRed()
			end
		end
		task.wait(SCAN_INTERVAL)
	end
end)

