task.spawn(function()
	paintDefault()
	while stateRoot.gen == MY_GEN do
		local items = getItemsFolder()
		if items then
			local children = items:GetChildren()
			if lastItemsSnapshot then
				-- if every previously-seen instance is gone AND new ones took their
				-- place, it was a round rebuild: reset the latch
				local sawOld = false
				for _, inst in ipairs(lastItemsSnapshot) do
					if inst.Parent == items then
						sawOld = true
						break
					end
				end
				local anyNew = false
				for _, c in ipairs(children) do
					if not table.find(lastItemsSnapshot, c) then
						anyNew = true
						break
					end
				end
				if not sawOld and anyNew then
					active = false
					paintDefault()
				end
			end
			lastItemsSnapshot = children
		end
		if soundPartPresent() then
			active = true
			paintRed()
		end
		task.wait(SCAN_INTERVAL)
	end
end)

