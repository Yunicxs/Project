local function checkEMF()
	local items = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Items")
	if not items then return false end
	local emf = items:FindFirstChild("EMF Reader")
	return emf ~= nil and emf:FindFirstChild("RecentlyLevelFive") ~= nil and emf.RecentlyLevelFive.Value == true
end

local function checkGhostWriting()
	local items = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Items")
	if not items then return false end
	local book = items:FindFirstChild("Ghost Writing Book")
	return book ~= nil and book:FindFirstChild("Written") ~= nil and book.Written.Value == true
end

local function checkUV()
	local map = Workspace:FindFirstChild("Map")
	if not map then return false end
	local prints = map:FindFirstChild("Prints")
	return prints ~= nil and #prints:GetChildren() > 0
end

local function checkOrbs()
	local map = Workspace:FindFirstChild("Map")
	if not map then return false end
	local orbs = map:FindFirstChild("Orbs")
	return orbs ~= nil and #orbs:GetChildren() > 0
end

local function checkFreezing()
	local map = Workspace:FindFirstChild("Map")
	if not map then return false end
	local zones = map:FindFirstChild("Zones")
	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("NumberValue") and descendant.Name == "_____Temperature" and descendant.Value < 0.05 then
			-- the Outside safe-zone does not count toward Freezing Temp. evidence
			if zones and descendant:IsDescendantOf(zones) then
				local ancestor = descendant.Parent
				while ancestor and ancestor ~= zones do
					if ancestor.Name == "Outside" then
						break
					end
					ancestor = ancestor.Parent
				end
				if ancestor == zones then
					-- never passed through a zone named Outside
					return true
				end
			else
				return true
			end
		end
	end
	return false
end

local function checkSpiritBox()
	local map = Workspace:FindFirstChild("Map")
	if not map then return false end
	local items = map:FindFirstChild("Items")
	if not items then return false end
	local sb = items:FindFirstChild("Spirit Box")
	if not sb then return false end
	local gt = sb:FindFirstChild("GhostTalk")
	if not gt then return false end
	for _, child in ipairs(gt:GetChildren()) do
		if child:IsA("Sound") and child.Playing then
			return true
		end
	end
	return false
end

local function checkSLS()
	local sls = Workspace:FindFirstChild("SLS_GHOST")
	return sls ~= nil
end

local checks = {
	["EMF Level 5"] = checkEMF,
	["Ghost Orb"] = checkOrbs,
	["SLS Anomaly"] = checkSLS,
	["Ultraviolet"] = checkUV,
	["Freezing Temp."] = checkFreezing,
	["Ghost Writing"] = checkGhostWriting,
	["Spirit Box"] = checkSpiritBox,
}

task.spawn(function()
	while state.gen == MY_GEN do
		if not bothEvidenceChallengesActive() then
			for name, fn in pairs(checks) do
				if not detected[name] then
					local ok, res = pcall(fn)
					if ok and res then
						detected[name] = true
					end
				end

				if detected[name] then
					markEvidence(name)
				end
			end
		end
		task.wait(SCAN_INTERVAL)
	end
end)

local api = {
	name = "EvidenceDetector",
	gen = MY_GEN,
	setDetected = function(name) detected[name] = true end,
	isDetected = function(name) return detected[name] or false end,
}
_G.__EvidenceDetectorAPI = api
_G.__EvidenceDetectorState.api = api

local UserInputService = game:GetService("UserInputService")

local doorsFolder = game.Workspace:FindFirstChild("Map") and game.Workspace.Map:FindFirstChild("Doors")
if not doorsFolder then
    warn("Doors folder not found at game.Workspace.Map.Doors")
    return
end

local storedDoors = {}
local isRemoved = false

-- Reference to the NoClip ImageLabel for color feedback
local noClipLabel = game:GetService("CoreGui"):FindFirstChild("ToggleUI") 
    and game:GetService("CoreGui").ToggleUI:FindFirstChild("TFrame") 
    and game:GetService("CoreGui").ToggleUI.TFrame:FindFirstChild("ToogleUI") 
    and game:GetService("CoreGui").ToggleUI.TFrame.ToogleUI:FindFirstChild("NoClip")

local function toggleDoors()
    isRemoved = not isRemoved
    
    if isRemoved then
        -- Remove and store doors
        for _, door in ipairs(doorsFolder:GetChildren()) do
            table.insert(storedDoors, door)
            door.Parent = nil
        end
        
        
        -- Set color to 255, 128, 128 (Reddish)
        if noClipLabel then
            noClipLabel.ImageColor3 = Color3.fromRGB(255, 128, 128)
        end
    else
        -- Restore doors from storage
        for _, door in ipairs(storedDoors) do
            door.Parent = doorsFolder
        end
        table.clear(storedDoors)
        
        
        -- Set color back to white
        if noClipLabel then
            noClipLabel.ImageColor3 = Color3.fromRGB(255, 255, 255)
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.N then
        toggleDoors()
    end
end)
