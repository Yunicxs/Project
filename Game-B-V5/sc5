-- instance -> { name, className, state }
-- state: "seen" (on map / currently unaccounted), "held" (a player holds it), "stolen", "consumed"
local seen = {}
local stolen = false
local appearAt = {}
local pendingMissing = {}
local THROW_GRACE = 2.0
local baselineDone = false
-- leftover-handle baseline: handle instances we have already accounted for this round
local knownRootHandles = {}
local roundHasFreshHandle = false
local getRootHandles
local function takeRootHandleSnapshot()
	knownRootHandles = getRootHandles()
	roundHasFreshHandle = false
end

