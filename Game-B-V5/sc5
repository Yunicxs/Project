local function isConsumableTool(tool)
	if tool.Name == "Salt" then
		return true
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("NumberValue") and d.Name == "Capacity" then
			return true
		end
	end
	return false
end

-- orphan handles at the workspace root (direct children), the salt-consumed leftover
getRootHandles = function()
	local handles = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "Handle" then
			handles[child] = true
		end
	end
	return handles
end

takeRootHandleSnapshot()

-- is this tool instance held by any player, in any of the three holding spots?
local function isHeldCampaign(tool)
	for _, plr in ipairs(Players:GetPlayers()) do
		-- Slot1..Slot5 ObjectValue references
		for i = 1, 5 do
			local slot = plr:FindFirstChild("Slot" .. i)
			if slot and slot.Value == tool then
				return true
			end
		end
		-- backpack children (indexing a held tool)
		for _, child in ipairs(plr.Backpack:GetChildren()) do
			if child == tool then
				return true
			end
		end
		-- equipped in the workspace player model
		local model = Workspace:FindFirstChild(plr.Name)
		if model then
			for _, child in ipairs(model:GetChildren()) do
				if child == tool then
					return true
				end
			end
		end
	end
	return false
end

task.spawn(function()
	paintWhite()
	while stateRoot.gen == MY_GEN do
		local items = getItemsFolder()
		if items then
			-- tools currently present on the map (same instances we track)
			local present = {}
			for _, child in ipairs(items:GetChildren()) do
				if child:IsA("Tool") then
					present[child] = true
					if not seen[child] then
						seen[child] = { name = child.Name, className = child.ClassName, state = "seen", consumable = isConsumableTool(child) }

						appearAt[child] = baselineDone and tick() or 0
					end
				end
			end
			baselineDone = true

			local liveCount = 0
			for inst in pairs(seen) do
				if present[inst] then
					liveCount = liveCount + 1
				end
			end
			local totalSeen = 0
			for _ in pairs(seen) do totalSeen = totalSeen + 1 end
			if totalSeen > 0 and liveCount == 0 and #items:GetChildren() > 0 then
				-- map completely rebuilt -> new round: reset tracking AND the latch
				for inst in pairs(seen) do seen[inst] = nil end
				for inst in pairs(pendingMissing) do pendingMissing[inst] = nil end
				for inst in pairs(appearAt) do appearAt[inst] = nil end
				for child, _ in pairs(present) do
					seen[child] = { name = child.Name, className = child.ClassName, state = "seen", consumable = isConsumableTool(child) }
					appearAt[child] = 0
				end
				stolen = false
				paintWhite()
				takeRootHandleSnapshot()
			else
				-- scan tracked instances: gone AND not held anywhere => stolen
				local mapToolsLeft = 0
				for _, child in ipairs(items:GetChildren()) do
					if child:IsA("Tool") then
						mapToolsLeft = mapToolsLeft + 1
					end
				end
				-- any NEW orphan handle counts as a "consumable used up" witness
				-- any NEW orphan handle marks consumables as "used up" for the whole round
				local freshHandles = getRootHandles()
				for h in pairs(freshHandles) do
					if not knownRootHandles[h] then
						roundHasFreshHandle = true
						break
					end
				end
				knownRootHandles = freshHandles

				local function findThrowReplacement(inst, meta, since)
					for child, _ in pairs(present) do
						if child ~= inst and child.Name == meta.name then
							local at = appearAt[child]
							if at and at >= since then
								return child
							end
						end
					end
					return nil
				end

				for inst, meta in pairs(seen) do
					if not present[inst] and meta.state ~= "stolen" and meta.state ~= "consumed" then
						if isHeldCampaign(inst) then
							meta.state = "held"
						elseif meta.consumable and roundHasFreshHandle then
							-- salt ran out: destroyed, Handle left behind -> used up, not stolen
							meta.state = "consumed"
							print(("[NookTraits] CONSUMED: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
						elseif meta.name == "GlowStick" then
							-- a freshly-spawned same-named instance is the throw's
							-- replacement: the old one was destroyed by the game
							if findThrowReplacement(inst, meta, tick() - THROW_GRACE) then
								seen[inst] = nil
								
							elseif not pendingMissing[inst] then
								-- wait a moment for the replacement to spawn
								pendingMissing[inst] = tick()
								meta.state = "pending"
							end
						elseif meta.name == "Sanity Soda" then

							if meta.state == "held" then
								meta.state = "consumed"
								print(("[NookTraits] CONSUMED: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
							else
								meta.state = "stolen"
								stolen = true
								print(("[NookTraits] STOLEN: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
							end
						else
							meta.state = "stolen"
							stolen = true
							print(("[NookTraits] STOLEN: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
						end
					end
				end

				-- resolve pending GlowStick throws: if a replacement appeared since
				-- the instance went missing, it was thrown, not stolen
				local now = tick()
				for inst, since in pairs(pendingMissing) do
					local meta = seen[inst]
					if not meta then
						pendingMissing[inst] = nil
					elseif present[inst] then
						-- came back on its own: safe again
						meta.state = "seen"
						pendingMissing[inst] = nil
					else
						local replacement = findThrowReplacement(inst, meta, since)
						if replacement then
							seen[inst] = nil
							pendingMissing[inst] = nil
							
						elseif now - since > THROW_GRACE then
							-- no replacement in time: real steal
							meta.state = "stolen"
							stolen = true
							pendingMissing[inst] = nil
							print(("[NookTraits] STOLEN: %s  -- tools left on map: %d"):format(meta.name, mapToolsLeft))
						end
					end
				end

				-- a previously-held tool dropped back between scans is safe again
				for inst, meta in pairs(seen) do
					if present[inst] and meta.state == "held" then
						meta.state = "seen"
					end
				end
			end

			if stolen then
				paintRed()
			end
		end
		task.wait(SCAN_INTERVAL)
	end
end)

