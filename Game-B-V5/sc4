-- Configuration
local TOGGLE_KEY = Enum.KeyCode.Six
local ESP_ENABLED = true
local SHINY_COLOR = Color3.fromRGB(255, 255, 90) -- Light yellow

-- Storage folder at Workspace (NOT inside characters) so ESP survives death
local ESP_FOLDER = Instance.new("Folder")
ESP_FOLDER.Name = "PlayerESP_Storage"
ESP_FOLDER.Parent = Workspace

-- Table of active ESP entries: player -> { billboard, dispLabel, userLabel, uiGradient, uiGradientBottom, anim }
local espEntries = {}

-- Get the current root part for a player's Workspace model (re-acquired every frame)
local function getRootPart(player)
    local model = Workspace:FindFirstChild(player.Name)
    if not model or not model:IsA("Model") then return nil end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    -- Fallback: find any BasePart so dead/limbless models still show ESP
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

-- Function to toggle ESP visibility
local function toggleESP()
    ESP_ENABLED = not ESP_ENABLED
    for _, entry in pairs(espEntries) do
        if entry.billboard then
            entry.billboard.Enabled = ESP_ENABLED
        end
    end
end

-- Set up keybind
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == TOGGLE_KEY then
        toggleESP()
    end
end)

