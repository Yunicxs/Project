-- Hold RMB logic (0.1s to unlock + show UI, release to select hovered)
local holdTime = 0
local isHolding = false
local isUnlocked = false

_G.SGC.inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isHolding = true
		holdTime = 0
	end
end)

_G.SGC.inputEndedConn = UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		-- on release: if unlocked and hovering a ghost, select it
		if isUnlocked and hoveredName then
			_G.SGC.selectGhost(hoveredName)
		end
		isHolding = false
		isUnlocked = false
		holdTime = 0
		_G.freemouse = false
		hideHoverUI()
		-- re-lock cursor for gameplay
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		if UserInputService.MouseIconEnabled == false then
			UserInputService.MouseIconEnabled = true
		end
	end
end)

_G.SGC.renderConn = RunService.RenderStepped:Connect(function(dt)
	if isHolding then
		holdTime = holdTime + dt
		if holdTime >= 0.1 and not isUnlocked then
			isUnlocked = true
			showHoverUI()
		end
	end

	if isUnlocked then
		_G.freemouse = true
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if not UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = true
		end
	else
		_G.freemouse = false
	end
end)

-- Watch Evidence tab selection so manual clicks sync label (+ keep journal sync)
local SEL_COLOR = Color3.fromRGB(52, 78, 58)
local SEL_TRANS = 0.25
local DEF_COLOR = Color3.fromRGB(25, 25, 25)
local DEF_TRANS = 0.2

local function isSelected(btn)
	local c = btn.BackgroundColor3
	local colorMatch = (math.abs(c.R - SEL_COLOR.R) < 0.02 and math.abs(c.G - SEL_COLOR.G) < 0.02 and math.abs(c.B - SEL_COLOR.B) < 0.02)
	local transMatch = math.abs(btn.BackgroundTransparency - SEL_TRANS) < 0.05
	return colorMatch and transMatch
end

local function watchTemplate(template)
	if not template:IsA("ImageButton") then return end
	local function checkSelection()
		if isSelected(template) then
			local buttons = getAllGhostButtonsForSelection()
			for _, c in ipairs(buttons) do
				if c ~= template then
					c.BackgroundColor3 = DEF_COLOR
					c.BackgroundTransparency = DEF_TRANS
				end
			end
			selectedGhostName = template.Name
			updateSelectedLabel(template.Name)
			if container.Visible then refreshHoverHighlights() end
		else
			local stillSelected = nil
			for _, c in ipairs(getAllGhostButtonsForSelection()) do
				if isSelected(c) then
					stillSelected = c.Name
					break
				end
			end
			selectedGhostName = stillSelected
			updateSelectedLabel(stillSelected or "")
			if container.Visible then refreshHoverHighlights() end
		end
	end
	template:GetPropertyChangedSignal("BackgroundColor3"):Connect(checkSelection)
	template:GetPropertyChangedSignal("BackgroundTransparency"):Connect(checkSelection)
	task.defer(checkSelection)
end

local function watchAllTemplates()
	for _, c in ipairs(getAllGhostButtonsForSelection()) do
		watchTemplate(c)
	end
end

watchAllTemplates()

local evidenceFrame = getGhostSelectionFrame()
if evidenceFrame then
	evidenceFrame.ChildAdded:Connect(function(child)
		if child:IsA("ImageButton") then
			watchTemplate(child)
		end
	end)
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local OutsidePart = Workspace.Map.Zones.Outside
local ZoneValue = LocalPlayer:WaitForChild("Zone")

local origCFrame = OutsidePart.CFrame
local origSize = OutsidePart.Size

local isEnabled = false
local bringRunning = false

local function restoreOriginal()
    OutsidePart.Size = origSize
    OutsidePart.CFrame = origCFrame
end

local function bringToCharacter()
    if bringRunning then return end
    bringRunning = true
    while isEnabled do
        local ok, err = pcall(function()
            local zoneName = ZoneValue.Value and ZoneValue.Value.Name or ""
            if zoneName ~= "Outside" then
                restoreOriginal()
                task.wait(0.3)
                if not isEnabled then return end
            end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                OutsidePart.Size = Vector3.new(1, 1, 1)
                OutsidePart.CFrame = CFrame.new(char.HumanoidRootPart.Position)
            end
        end)
        if not ok then break end
        task.wait(0.05)
    end
    restoreOriginal()
    bringRunning = false
end

local function toggle()
    isEnabled = not isEnabled
    if isEnabled then
        bringToCharacter()
    else
        restoreOriginal()
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.X and not processed then
        toggle()
    end
end)

print("Done")
