-- watch journal Selection (BackgroundColor3 + BackgroundTransparency on ImageButton in Evidence tab) so manual clicks in the Journal sync the label
local SELECTED_COLOR = Color3.fromRGB(52, 78, 58)
local SELECTED_TRANSPARENCY = 0.25
local DEFAULT_COLOR = Color3.fromRGB(25, 25, 25)
local DEFAULT_TRANSPARENCY = 0.2

local function isSelected(btn)
	-- More robust check: ignore small floating point errors for both color and transparency
	local colorMatch = (btn.BackgroundColor3.R > SELECTED_COLOR.R - 0.01 and btn.BackgroundColor3.R < SELECTED_COLOR.R + 0.01) and
		           (btn.BackgroundColor3.G > SELECTED_COLOR.G - 0.01 and btn.BackgroundColor3.G < SELECTED_COLOR.G + 0.01) and
		           (btn.BackgroundColor3.B > SELECTED_COLOR.B - 0.01 and btn.BackgroundColor3.B < SELECTED_COLOR.B + 0.01)
	local transMatch = math.abs(btn.BackgroundTransparency - SELECTED_TRANSPARENCY) < 0.05
	return colorMatch and transMatch
end

local function getGhostName(btn)
	-- Evidence tab buttons use their Name property directly
	return btn.Name
end

local function watchTemplate(template)
	if not template:IsA("ImageButton") then return end
	
	local function checkSelection()
		if isSelected(template) then
			-- a manual click happened. Forcefully deselect EVERY other button first to prevent duplicates
			local buttons = getAllGhostButtonsForSelection()
			for _, c in ipairs(buttons) do
				if c ~= template then
					c.BackgroundColor3 = DEFAULT_COLOR
					c.BackgroundTransparency = DEFAULT_TRANSPARENCY
				end
			end
			updateSelectedLabel(getGhostName(template))
		else
			-- template was deselected. Check if any other button is now the sole selected one
			local stillSelected = nil
			local buttons = getAllGhostButtonsForSelection()
			for _, c in ipairs(buttons) do
				if isSelected(c) then
					stillSelected = getGhostName(c)
					break
				end
			end
			updateSelectedLabel(stillSelected or "")
		end
	end
	
	template:GetPropertyChangedSignal("BackgroundColor3"):Connect(checkSelection)
	template:GetPropertyChangedSignal("BackgroundTransparency"):Connect(checkSelection)
	
	-- initial check
	task.defer(checkSelection)
end

local function watchAllTemplates()
	for _, c in ipairs(getAllGhostButtonsForSelection()) do
		watchTemplate(c)
	end
end

