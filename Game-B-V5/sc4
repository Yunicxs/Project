local function syncSelection(chosenName)
	local buttons = getAllGhostButtonsForSelection()
	local lowered = chosenName and string.lower(chosenName) or ""
	local SELECTED_COLOR = Color3.fromRGB(52, 78, 58)
	local SELECTED_TRANSPARENCY = 0.25
	local UNSELECTED_COLOR = Color3.fromRGB(25, 25, 25)
	local UNSELECTED_TRANSPARENCY = 0.2
	for _, btn in ipairs(buttons) do
		local isMatch = (lowered ~= "" and string.lower(btn.Name) == lowered)
		if isMatch then
			btn.BackgroundColor3 = SELECTED_COLOR
			btn.BackgroundTransparency = SELECTED_TRANSPARENCY
		else
			btn.BackgroundColor3 = UNSELECTED_COLOR
			btn.BackgroundTransparency = UNSELECTED_TRANSPARENCY
		end
	end
end

local function selectGhost(name)
	local template = findGhostTemplate(name)
	if template then
		SelectGhostEvent:FireServer(name)
		syncSelection(name)
		return true, name
	else
		SelectGhostEvent:FireServer("No Ghost Found")
		syncSelection("")
		return false, name
	end
end

