-- AutoIgnitedCandles - Manual ignite via keybind E

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- UserInputService grabbed up front so the E handler (Section 5)
-- is registered as early as possible (top of the script).
local UserInputService = game:GetService("UserInputService")

local CandlesFolder = workspace.Map.Candles

-- Server ignite remote. Firing it directly bypasses the Lighter
-- (the ProximityPrompt path is server-gated on a lit Lighter,
-- but this remote call is accepted when you are in range).
local LightCandle = ReplicatedStorage.Remotes.LightCandle

-- All candle/light targets (table persists; re-scans only add new).
local IgniteTargets = {}

-- Add a target only if it is not already collected, so re-scans
-- never duplicate or re-check existing entries.
local function AddTargetIfNew(obj)
    for _, t in ipairs(IgniteTargets) do
        if t == obj then
            return false
        end
    end
    table.insert(IgniteTargets, obj)
    return true
end

-- Scan one folder/parent for valid candle/light targets.
local function ScanForTargets(parent)
    if not parent then return end
    for _, obj in ipairs(parent:GetChildren()) do
        if obj.Name == "Light" and obj:IsA("Model") then
            AddTargetIfNew(obj)
        elseif obj.Name == "Candle" and obj:IsA("BasePart") then
            AddTargetIfNew(obj)
        end
    end
end

-- Initial collection (Map.Candles + SummoningCircle).
local SummoningCircle = workspace:FindFirstChild("SummoningCircle")
ScanForTargets(CandlesFolder)
ScanForTargets(SummoningCircle)

local RunService = game:GetService("RunService")
local RESCAN_DELAY = 10   -- seconds between re-scans

local lastRescan = 0
RunService.Heartbeat:Connect(function(dt)
    lastRescan = lastRescan + dt
    if lastRescan >= RESCAN_DELAY then
        lastRescan = 0
        -- SummoningCircle may spawn later, so re-find it too
        SummoningCircle = workspace:FindFirstChild("SummoningCircle")
        ScanForTargets(CandlesFolder)
        ScanForTargets(SummoningCircle)
    end
end)

-- ============================================================
-- Section 2 of 5: Helpers (character root, position, lit-check)
-- ============================================================

local function GetCharacterRoot()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function GetTargetPosition(target)
    if target:IsA("Model") then
        if target.PrimaryPart then
            return target.PrimaryPart.Position
        end
        return target:GetPivot().Position
    end
    return target.Position
end

local function IsAlreadyLit(target)
    local flag = target:FindFirstChild("IsIgnited")
    return flag and flag:IsA("BoolValue") and flag.Value == true
end

-- Section 3 of 5: Sync prompts to lit-state (visual)

local function GetPromptFor(target)
    if target:IsA("Model") then
        local holder = target:FindFirstChild("lightholder")
        if holder then
            return holder:FindFirstChild("IgniteCandlePrompt")
        end
    else
        return target:FindFirstChild("IgniteCandlePrompt")
    end
    return nil
end

local function SyncPrompts()
    for _, target in ipairs(IgniteTargets) do
        if target and target.Parent then
            local prompt = GetPromptFor(target)
            if prompt and prompt:IsA("ProximityPrompt") then
                if IsAlreadyLit(target) then
                    prompt.Enabled = false
                else
                    prompt.Enabled = true
                    prompt.HoldDuration = 0
                    prompt.MaxActivationDistance = 10
                end
            end
        end
    end
end

RunService:BindToRenderStep(
    "AutoIgnitedCandles_PromptSync",
    Enum.RenderPriority.Last.Value,
    SyncPrompts
)

-- Section 4 of 5: Manual ignite function (fired by keybind E)

local MANUAL_RANGE = 15

local function IgniteNearestManual()
    local root = GetCharacterRoot()
    if not root then return end
    local myPos = root.Position

    local best, bestDist = nil, MANUAL_RANGE
    for _, target in ipairs(IgniteTargets) do
        if target and target.Parent and not IsAlreadyLit(target) then
            local dist = (GetTargetPosition(target) - myPos).Magnitude
            if dist <= bestDist then
                bestDist = dist
                best = target
            end
        end
    end

    if best then
        local ok, err = pcall(function()
            LightCandle:FireServer(best)
        end)
        if not ok then
            warn("[AutoIgnitedCandles] manual ignite error:", err)
        end
    end
end

-- Section 5 of 5: Bind key E to manual ignite (registered early,

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.E then
        IgniteNearestManual()
    end
end)

-- Section 6 of 6: AUTO ignite loop (toggle LeftAlt)


local AutoIgniteEnabled = false   -- starts OFF; press LeftAlt to toggle
local AUTO_RANGE = 20
local AUTO_STEP_DELAY = 0.1      -- seconds between auto passes

-- (UserInputService is already declared at the top in Section 1)

local function TryAutoIgnite()
    if not AutoIgniteEnabled then return end

    local root = GetCharacterRoot()
    if not root then return end
    local myPos = root.Position

    for _, target in ipairs(IgniteTargets) do
        if target and target.Parent and not IsAlreadyLit(target) then
            local dist = (GetTargetPosition(target) - myPos).Magnitude
            if dist <= AUTO_RANGE then
                local ok, err = pcall(function()
                    LightCandle:FireServer(target)
                end)
                if not ok then
                    warn("[AutoIgnitedCandles] auto ignite error:", err)
                end
            end
        end
    end
end

local lastAuto = 0
RunService.Heartbeat:Connect(function(dt)
    lastAuto = lastAuto + dt
    if lastAuto >= AUTO_STEP_DELAY then
        lastAuto = 0
        local ok, err = pcall(TryAutoIgnite)
        if not ok then
            warn("[AutoIgnitedCandles] auto loop error:", err)
        end
    end
end)

-- LeftAlt toggles auto-ignite on/off (gameProcessed guard kept
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftAlt then
        AutoIgniteEnabled = not AutoIgniteEnabled
    end
end)


--[[
    GhostWalkspeedDetection (v3)
--]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GHOST_NAME = "Ghost"

local COL_BASE   = Color3.fromRGB(255, 255, 255) -- stable
local COL_UP     = Color3.fromRGB(255, 80, 80)  -- increased
local COL_DOWN   = Color3.fromRGB(80, 255, 120)   -- decreased

local active = {
    ghost = nil,
    gui = nil,
    text = nil,
    colorTween = nil,
    speedConn = nil,
    rtConn = nil,
    lastSpeed = nil,
}

local function safeDestroy(inst)
    if inst and inst:IsA("Instance") and inst.Parent then
        inst:Destroy()
    end
end

local function cleanup()
    if active.speedConn then active.speedConn:Disconnect() active.speedConn = nil end
    if active.rtConn then active.rtConn:Disconnect() active.rtConn = nil end
    if active.colorTween then active.colorTween:Cancel() active.colorTween = nil end
    safeDestroy(active.gui)
    active.gui = nil
    active.text = nil
    active.ghost = nil
    active.lastSpeed = nil
end

-- minimal: just a speed text label, no backgrounds
local function createBillboard(ghost)
    local adornee = ghost:FindFirstChild("HumanoidRootPart")
        or ghost:FindFirstChild("Head")
        or ghost.PrimaryPart

    local text = Instance.new("TextLabel")
    text.Name = "SpeedText"
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    text.Font = Enum.Font.GothamBold
    text.TextSize = 24
    text.Text = "-"
    text.TextColor3 = COL_BASE
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.TextStrokeTransparency = 0.35
    text.TextScaled = false

    local gui = Instance.new("BillboardGui")
    gui.Name = "GhostSpeedUI"
    gui.Size = UDim2.new(0, 220, 0, 60)
    gui.StudsOffset = Vector3.new(0, 3.2, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 0          -- INFINITE range: never invisible when far
    gui.LightInfluence = 0
    gui.Adornee = adornee
    text.Parent = gui
    gui.Parent = adornee or ghost
    return gui, text
end

local function setColor(target)
    if active.colorTween then active.colorTween:Cancel() end
    active.colorTween = TweenService:Create(
        active.text,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { TextColor3 = target }
    )
    active.colorTween:Play()
    -- settle back to base white after the flash
    task.delay(0.45, function()
        if active.text and active.text.Parent then
            if active.colorTween then active.colorTween:Cancel() end
            active.colorTween = TweenService:Create(
                active.text,
                TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { TextColor3 = COL_BASE }
            )
            active.colorTween:Play()
        end
    end)
end

local function refresh(ghost)
    local hum = ghost:FindFirstChildOfClass("Humanoid")
    if not hum or not active.text then return end

    local ws = hum.WalkSpeed
    active.text.Text = string.format("%.2f", ws)

    if active.lastSpeed ~= nil then
        if ws > active.lastSpeed + 1e-4 then
            setColor(COL_UP)
        elseif ws < active.lastSpeed - 1e-4 then
            setColor(COL_DOWN)
        end
    end
    active.lastSpeed = ws
end

local function attach(ghost)
    if active.ghost == ghost then return end -- already tracking
    cleanup()                                -- no duplicates
    active.ghost = ghost

    local gui, text = createBillboard(ghost)
    active.gui = gui
    active.text = text

    local hum = ghost:FindFirstChildOfClass("Humanoid")
        or ghost:WaitForChild("Humanoid", 5)
    if hum then
        active.speedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            refresh(ghost)
        end)
        refresh(ghost) -- init
    end

    active.rtConn = ghost.AncestryChanged:Connect(function()
        if not ghost:IsDescendantOf(workspace) then
            cleanup()
        end
    end)
end

-- spawn detection
workspace.ChildAdded:Connect(function(child)
    if child.Name == GHOST_NAME and child:IsA("Model") then
        task.defer(attach, child)
    end
end)

local existing = workspace:FindFirstChild(GHOST_NAME)
if existing then task.defer(attach, existing) end

-- safety cleanup if ghost destroyed
RunService.Heartbeat:Connect(function()
    if active.ghost and not active.ghost:IsDescendantOf(workspace) then
        cleanup()
    end
end)



